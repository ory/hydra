FROM golang:1.26 AS builder

WORKDIR /go/src/github.com/ory/hydra

COPY oryx/go.mod oryx/go.mod
COPY oryx/go.sum oryx/go.sum
                

RUN apt-get update && apt-get upgrade -y &&\
    mkdir -p ./internal/httpclient

COPY go.mod go.sum ./
COPY internal/httpclient/go.* ./internal/httpclient/

RUN go mod download

COPY . .
# -buildvcs=false keeps the main module unversioned even if .git ever returns to
# the build context. Without it, Go stamps a pseudo-version built from whatever git
# state the builder happens to see: a shallow checkout has no reachable tag and
# .dockerignore omits tracked paths, which yields v2.0.0-<timestamp>-<sha>+dirty
# -- a version that sorts below every release, so vulnerability scanners report
# advisories this build already contains the fix for. Released binaries come from
# GoReleaser, which records the version through driver/config.Version, so nothing
# depends on the stamp.
RUN CGO_ENABLED=0 go build -buildvcs=false -o /usr/bin/hydra

#########################

FROM gcr.io/distroless/static-debian12:debug-nonroot AS runner

COPY --from=builder /usr/bin/hydra /usr/bin/hydra

# Declare the standard ports used by hydra (4444 for public service endpoint, 4445 for admin service endpoint)
EXPOSE 4444 4445

ENTRYPOINT ["hydra"]
CMD ["serve", "all"]
